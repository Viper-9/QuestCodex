@page "/questcodex"
@layout EmptyLayout
@rendermode InteractiveServer
@implements IAsyncDisposable
@using static Microsoft.AspNetCore.Components.Web.RenderMode
@using Microsoft.JSInterop
@using QuestCodex.Services
@using SPTarkov.Common.Models.Logging
@inject ViteManifest Manifest
@inject IJSRuntime JS
@inject ProfileChangeNotifier Notifier
@inject ISptLogger<Index> Logger

<PageTitle>QuestCodex</PageTitle>

<HeadContent>
    @foreach (var css in Manifest.Entry.Css)
    {
        <link rel="stylesheet" href="@css" />
    }
</HeadContent>

<div id="questcodex-root"></div>

@code {
    private IJSObjectReference? _module;
    private bool _subscribed;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        // ES 모듈은 같은 문서 안에서 URL당 한 번만 평가되므로, 모듈 로드 부수효과가 아니라
        // export 된 mount() 를 매 방문마다 명시적으로 호출해야 재방문 시에도 React 가 뜬다.
        _module = await JS.InvokeAsync<IJSObjectReference>("import", Manifest.Entry.Js);
        await _module.InvokeVoidAsync("mount", "questcodex-root");

        // 프로필 변경 푸시(레이드 종료·메뉴 퀘스트 조작): 서버 이벤트 → 이 서킷 → JS notify(). 이 페이지가 살아 있는 동안만 구독한다.
        Notifier.ProfileUpdated += OnProfileUpdated;
        _subscribed = true;
    }

    private void OnProfileUpdated(ProfileChange change)
    {
        // 라우터/스레드풀 스레드에서 호출되므로 컴포넌트 디스패처로 넘긴다. 실패해도 서버에는 영향 없음.
        _ = InvokeAsync(async () =>
        {
            if (_module is null)
            {
                return;
            }

            try
            {
                // changedQuestIds 는 "무엇이 바뀌었는지 아는" 경우(메뉴 diff)에만 실린다. 레이드 종료는
                // 필드 자체를 빼서 브라우저가 전체 재요청하도록 한다 (null 로 보내지 않는다).
                object msg = change.ChangedQuestIds is null
                    ? new { type = "profileUpdated", profileId = change.ProfileId }
                    : new { type = "profileUpdated", profileId = change.ProfileId, changedQuestIds = change.ChangedQuestIds };
                await _module.InvokeVoidAsync("notify", msg);
            }
            catch (JSDisconnectedException)
            {
                // 서킷이 끊긴 탭. 다음 방문 때 visibilitychange 재요청이 보정한다.
            }
            catch (Exception ex)
            {
                Logger.Warning($"[QuestCodex] notify failed: {ex.Message}", ex);
            }
        });
    }

    public async ValueTask DisposeAsync()
    {
        if (_subscribed)
        {
            Notifier.ProfileUpdated -= OnProfileUpdated;
            _subscribed = false;
        }

        if (_module is null)
        {
            return;
        }

        try
        {
            await _module.InvokeVoidAsync("unmount");
            await _module.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
            // 서킷이 이미 끊긴 경우(탭 닫힘 등) 정리할 JS 컨텍스트가 없다.
        }
    }
}
