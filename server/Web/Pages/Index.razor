@page "/questcodex"
@layout EmptyLayout
@rendermode InteractiveServer
@using static Microsoft.AspNetCore.Components.Web.RenderMode
@using Microsoft.JSInterop
@inject ViteManifest Manifest
@inject IJSRuntime JS

<PageTitle>QuestCodex</PageTitle>

<HeadContent>
    @foreach (var css in Manifest.Entry.Css)
    {
        <link rel="stylesheet" href="@css" />
    }
</HeadContent>

<div id="questcodex-root"></div>

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // 동적 import 로 Vite 엔트리 모듈을 로드 → React 가 #questcodex-root 에 마운트.
            await JS.InvokeAsync<IJSObjectReference>("import", Manifest.Entry.Js);
        }
    }
}
